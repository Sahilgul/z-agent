#!/usr/bin/env python3
"""git credential helper (credential mechanics).

A PAT NEVER lands in remote URLs or .git/config. Clones configure:

  git config credential.helper ""
  git config credential.helper "!python3 /app/scripts/git-credential-zagent"
  git config credential.useHttpPath true

Which PAT depends on the tier: the golden fetcher exports ZAGENT_CREDENTIAL_SCOPE=fetch
(FETCH_PAT, Code:Read ONLY); workers export ZAGENT_CREDENTIAL_SCOPE=fleet (FLEET_PAT).
"""

import os
import sys


def main() -> None:
    if len(sys.argv) < 2 or sys.argv[1] != "get":
        return
    # consume the stdin credential query (protocol/host/path) without using it
    for line in sys.stdin:
        if line.strip() == "":
            break
    scope = os.environ.get("ZAGENT_CREDENTIAL_SCOPE", "fetch")
    pat = os.environ.get("FETCH_PAT" if scope == "fetch" else "FLEET_PAT", "")
    if not pat:
        sys.exit(1)
    sys.stdout.write("username=zagent\n")
    sys.stdout.write(f"password={pat}\n\n")


if __name__ == "__main__":
    main()

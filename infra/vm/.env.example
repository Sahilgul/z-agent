# Zagent VM env — copy to infra/vm/.env and fill. NEVER commit real values.

# --- App DB (Postgres in Docker, same VM) ---
POSTGRES_PASSWORD=            # openssl rand -hex 16

# --- LLM gateway ---
LITELLM_MASTER_KEY=sk-zagent-master-change-me
GATEWAY_DB_PASSWORD=          # openssl rand -hex 16
AZURE_AI_FOUNDRY_API_KEY=
# Foundry endpoint is set in infra/litellm/config.yaml (api_base) — edit there.

# --- Azure DevOps (TWO PATs, plan §10; service account, NOT your identity) ---
ADO_ORG=bostonhealthai
ADO_PROJECT=Product
FETCH_PAT=                    # Code:Read ONLY — golden fetcher
FLEET_PAT=                    # Code:Read&Write, service account — workers (push/PR)
ADO_WEBHOOK_SECRET=           # openssl rand -hex 32 — ADO service-hook HMAC
SERVICE_ACCOUNT_DESCRIPTOR=   # the service account's OWN ADO descriptor (loop guard)

# --- App ---
ZAGENT_JWT_SECRET=            # openssl rand -hex 32
ZAGENT_ADMIN_USERNAMES=sahil
ZAGENT_BOOTSTRAP_ADMIN_USERNAME=sahil
ZAGENT_BOOTSTRAP_ADMIN_PIN=   # first-admin PIN (seed creates ACTIVE admin once)

# --- Tailscale (tailnet-only access; no public ports) ---
# Reusable auth key from tailnet admin (tagged, ephemeral=false). Leave empty
# for one-time interactive login: docker compose --profile tailscale exec tailscale tailscale up
TS_AUTHKEY=

# Zagent VM env — copy to infra/vm/.env and fill. NEVER commit real values.
# Each key must appear EXACTLY ONCE — a later duplicate silently overrides
# the earlier value (e.g. GATEWAY_DB_PASSWORD=change-me at the bottom killed
# the gateway because the real password was set earlier in the file).

# --- App DB (Postgres in Docker, same VM) ---
POSTGRES_PASSWORD=            # openssl rand -hex 16

# --- LLM gateway ---
LITELLM_MASTER_KEY=sk-zagent-master-change-me
GATEWAY_DB_PASSWORD=          # openssl rand -hex 16
AZURE_AI_FOUNDRY_API_KEY=
# Which Foundry deployment the gateway's "kimi-foundry" alias routes to.
# FOUNDRY_MODEL = <litellm provider>/<your deployment name>. Use the openai/
# provider with Foundry's OpenAI-compatible base (.../openai/v1), or azure_ai/
# with the inference base (.../models).
FOUNDRY_MODEL=openai/Kimi-K2.6
FOUNDRY_API_BASE=https://YOUR-RESOURCE.services.ai.azure.com/openai/v1

# --- Azure DevOps (TWO PATs; service account, NOT your identity) ---
ADO_ORG=zagentharnessai
ADO_PROJECT=Product
FETCH_PAT=                    # Code:Read ONLY — golden fetcher
FLEET_PAT=                    # Code:Read&Write, service account — workers (push/PR)
ADO_WEBHOOK_SECRET=           # openssl rand -hex 32 — ADO service-hook HMAC
SERVICE_ACCOUNT_DESCRIPTOR=   # the service account's OWN ADO descriptor (loop guard)

# --- App ---
ZAGENT_JWT_SECRET=            # openssl rand -hex 32
ZAGENT_ADMIN_USERNAMES=sahil
ZAGENT_BOOTSTRAP_ADMIN_USERNAME=sahil
ZAGENT_BOOTSTRAP_ADMIN_PIN=   # first-admin PIN (seed creates ACTIVE admin once)
ZAGENT_BYO_PAT_ENCRYPTION_KEY=  # openssl rand -hex 32 — at-rest key for user PATs

# --- Durable state on the VM disk ---
# Golden clones, session volumes, workspaces, JSONL transcripts, evidence.
# Thread containers are siblings of the backend, so the host daemon resolves
# these paths: they are mounted into the backend at the SAME path they have
# on the host. deploy.sh creates them. Back up this one directory and you
# have it all.
ZAGENT_DATA_ROOT=/srv/zagent
